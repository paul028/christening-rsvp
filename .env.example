# ═══════════════════════════════════════════════════════════
# Christening RSVP — Environment Variables
# Copy this file to .env (in the repo root) and fill in your values.
# Single source of truth for backend, frontend, and admin-frontend.
# ═══════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────
APP_ENV=dev

# ── Backend (FastAPI) ────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DATA_DIR=./data
# Comma-separated origins allowed by FastAPI's CORS middleware.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://danyarsvp.pnonat.com,https://danyainternal.pnonat.com
# HTTP Basic credentials for the admin dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ── Frontend build-time config ───────────────────────────
# Backend URL the React apps call. Leave blank for local dev so they
# fall back to the Vite proxy at /api → http://backend:8000.
# In production this must be the absolute URL of the backend domain.
VITE_BACKEND_URL=
# Public URL where guests open their RSVP. The admin embeds this in
# generated links. Leave blank to default to window.location.origin.
VITE_GUEST_PUBLIC_URL=

# ── Deployment URLs (used by nginx-host/setup.sh) ────────
# These three drive the nginx template + Let's Encrypt certs.
GUEST_URL=https://danyarsvp.pnonat.com
ADMIN_URL=https://danyainternal.pnonat.com
BASE_URL=https://danyabackend.pnonat.com
CERTBOT_EMAIL=admin@example.com
